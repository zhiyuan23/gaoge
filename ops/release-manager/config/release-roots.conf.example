      "healthUrls": ["https://finance.gaoge.cc/health", "https://admin-finance.gaoge.cc/"],
      "requiredPaths": [
        "package.json",
        "pnpm-lock.yaml",
        "infra/pm2/ecosystem.config.cjs",
        "apps/api/dist/main.js",
        "apps/web/.next/standalone/apps/web/server.js",
        "apps/admin/dist/index.html"
      ],
      "auditPaths": [],
      "keepSuccessful": 3,
      "failedTtlHours": 24
    }
  ]
