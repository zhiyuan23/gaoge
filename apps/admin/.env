# ========================
# 公共配置（所有环境都会加载）
# ========================

# 应用配置面板
VITE_APP_TITLE = 高歌数字

# API 通用前缀；生产环境已去掉后端 /api 前缀，留空即可
VITE_APP_API_PREFIX =

# 静态资源前缀
VITE_APP_IMAGE_PREFIX = /images
VITE_APP_DOC_PREFIX = /docs

# 调试工具
VITE_APP_DEBUG_TOOL =

# 禁用开发者工具（默认关闭）
VITE_APP_DISABLE_DEVTOOL = false

# 构建配置（默认关闭）
VITE_BUILD_MOCK = false
VITE_BUILD_SOURCEMAP = false
VITE_BUILD_COMPRESS = gzip,brotli
VITE_BUILD_ARCHIVE =
