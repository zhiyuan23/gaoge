{
  "easycom": {
    "custom": {
      "^t-(.*)": "@tdesign/uniapp/$1/$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "高歌"
      }
    },
    {
      "path": "pages/discover/index",
      "style": {
        "navigationBarTitleText": "发现"
      }
    },
    {
      "path": "pages/rumor-post/index",
      "style": {
        "navigationBarTitleText": "流言板"
      }
    },
    {
      "path": "pages/team/index",
      "style": {
        "navigationBarTitleText": "球队"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/football/player/index",
      "style": {
        "navigationBarTitleText": "球员列表"
      }
    },
    {
      "path": "pages/football/asset/index",
      "style": {
        "navigationBarTitleText": "球队资产明细"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages/common",
      "pages": [
        {
          "path": "webview/index",
          "style": {
            "navigationBarTitleText": ""
          }
        },
        {
          "path": "404/index",
          "style": {
            "navigationBarTitleText": "404",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "historyRecord/index",
          "style": {
            "navigationBarTitleText": "历史记录"
          }
        },
        {
          "path": "historyRecord/detail",
          "style": {
            "navigationBarTitleText": "记录详情"
          }
        }
      ]
    }
  ],
  "preloadRule": {},
  "tabBar": {
    "color": "#8E8E93",
    "selectedColor": "#111827",
    "borderStyle": "black",
    "backgroundColor": "#F5F7FB",
    "list": [
      {
        "text": "高歌",
        "pagePath": "pages/home/index",
        "iconPath": "static/images/tabbar/home.png",
        "selectedIconPath": "static/images/tabbar/home-active.png"
      },
      {
        "text": "流言板",
        "pagePath": "pages/rumor-post/index",
        "iconPath": "static/images/tabbar/message.png",
        "selectedIconPath": "static/images/tabbar/message-active.png"
      },
      {
        "text": "球队",
        "pagePath": "pages/team/index",
        "iconPath": "static/images/tabbar/profile.png",
        "selectedIconPath": "static/images/tabbar/profile-active.png"
      },
      {
        "text": "我的",
        "pagePath": "pages/profile/index",
        "iconPath": "static/images/tabbar/profile.png",
        "selectedIconPath": "static/images/tabbar/profile-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "高歌体育",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#ffffff"
  }
}
