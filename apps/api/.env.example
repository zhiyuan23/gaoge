# Copy this file to `.env.local` for local development.
# Production should use a server-side `.env` managed outside git.

# 微信小程序配置
WECHAT_APPID=
WECHAT_APPSECRET=

# JWT 配置
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_IN=

# 数据库配置
DATABASE_URL=

# 应用配置
NODE_ENV=
PORT=
# 生产建议配置为固定绝对路径，例如 /var/www/gaoge-data/uploads
API_UPLOAD_ROOT=

# 图片上传 OSS 配置。本地和生产都应配置完整 OSS；未配置时仅作为开发兜底回退本地 uploads。
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PUBLIC_BASE_URL=
ALIYUN_OSS_PREFIX=gaoge

# 后台管理员初始化（用于 seed）
ADMIN_ACCOUNT=
ADMIN_PASSWORD=
