# Copy this file to `.env.local` for local development.
# Production should use a server-side `.env` managed outside git.

# 微信小程序配置
WECHAT_APPID=
WECHAT_APPSECRET=

# JWT 配置
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_IN=

# 数据库配置
DATABASE_URL=

# 应用配置
NODE_ENV=
PORT=
# 生产建议配置为固定绝对路径，例如 /var/www/gaoge-data/uploads
API_UPLOAD_ROOT=

# 后台管理员初始化（用于 seed）
ADMIN_ACCOUNT=
ADMIN_PASSWORD=
